<launch>
    <node name="joint_state_broadcaster" pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node name="wheel_controller" pkg="controller_manager" exec="spawner" args="wheel_controller" />
    <node name="cmd_filter" pkg="firo_control" exec="twist_stamped_filter">
        <remap from="/in" to="/cmd_vel" />
        <remap from="/out" to="/wheel_controller/cmd_vel" />
    </node>
</launch>
